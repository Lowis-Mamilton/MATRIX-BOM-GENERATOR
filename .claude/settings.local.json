{
  "permissions": {
    "allow": [
      "Skill(update-config)",
      "PowerShell(git *)",
      "Bash(node *)",
      "Read(//tmp/**)",
      "Bash(tar xzf *)",
      "Bash(rm -f C:/LTP/CODE/MATRIX-BOM-GENERATOR/check.mjs)",
      "Bash(rm -rf /tmp/docxcheck)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(grep -iE \"\\\\.js$|\\\\.html$\")",
      "Bash(git ls-tree *)",
      "Skill(run)",
      "Bash(chromium-cli --help)",
      "Bash(npx --yes playwright --version)",
      "Bash(npm init *)",
      "Bash(npm install *)",
      "Bash(taskkill //F //IM python.exe)",
      "Bash(curl *)",
      "Bash(grep -n \"^\\\\s*\\\\\\(async \\\\\\)\\\\?function \\\\|^\\\\s*const [A-Za-z_]* = \\\\\\(async \\\\\\)\\\\?\\(\\\\|=> {$\" shopscript.js)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$s = git status --porcelain; if ($s) { git add .; git commit -m 'auto-backup before claude edit' }",
            "shell": "powershell",
            "timeout": 30,
            "statusMessage": "Creating auto-backup commit..."
          }
        ]
      }
    ]
  }
}
